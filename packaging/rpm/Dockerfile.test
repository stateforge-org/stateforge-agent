FROM fedora:42

ENV container=docker

RUN dnf -y install \
        findutils \
        jq \
        python3 \
        python3-pip \
        procps-ng \
        rpm \
        shadow-utils \
        systemd \
    && dnf clean all \
    && systemctl mask \
        dev-hugepages.mount \
        sys-fs-fuse-connections.mount \
        systemd-remount-fs.service

STOPSIGNAL SIGRTMIN+3

CMD ["/sbin/init"]
